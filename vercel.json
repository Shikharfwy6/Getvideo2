{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/favicon.ico",
      "status": 204
    },
    {
      "src": "/webhook",
      "dest": "main.py"
    },
    {
      "src": "/",
      "dest": "main.py"
    }
  ]
}
